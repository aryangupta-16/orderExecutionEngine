generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum OrderStatus {
  PENDING
  ROUTING
  BUILDING
  SUBMITTED
  CONFIRMED
  FAILED
}

model Order {
  id              String      @id @default(uuid())

  idempotencyKey  String      @unique
  
  inputToken      String
  outputToken     String
  amount          Float
  slippage        Float
  orderType       String
  status          OrderStatus
  dex             String?
  executionPrice  Float?
  txHash          String?
  error           String?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}
